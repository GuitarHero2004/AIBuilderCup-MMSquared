# Local-only Firebase demo project. Start the Auth and Firestore emulators first.
VITE_APP_ENV=local
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_FIREBASE_PROJECT_ID=demo-greenprocure
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Production builds must explicitly set VITE_APP_ENV=production, an HTTPS API,
# real Firebase web configuration and a registered reCAPTCHA Enterprise score-based App Check site key.
# Do not set an emulator URL or App Check debug token in production.
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_APPCHECK_SITE_KEY=
