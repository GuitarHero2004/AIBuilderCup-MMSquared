# Isolated local emulators only. This is not a real Firebase project.
APP_ENV=local
GOOGLE_CLOUD_PROJECT=demo-greenprocure
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
APP_CHECK_REQUIRED=false
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Production must remove every emulator variable, set a real project, HTTPS origins,
# APP_CHECK_REQUIRED=true and APP_CHECK_APP_IDS=["your-registered-firebase-web-app-id"].
# No service-account keys, model keys or live AI are used by this foundation.
