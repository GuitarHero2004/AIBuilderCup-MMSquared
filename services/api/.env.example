# Isolated local emulators only. This is not a real Firebase project.
APP_ENV=local
GOOGLE_CLOUD_PROJECT=demo-greenprocure
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
APP_CHECK_REQUIRED=false
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AI_ENABLED=false
# Local storage defaults to demo-greenprocure.appspot.com on the loopback emulator.
# Local mode never calls Gemini. There is no fixture-AI fallback in the application.

# Production: remove every emulator variable and use runtime identity, never key files.
# APP_ENV=production
# GOOGLE_CLOUD_PROJECT=your-project-id
# APP_CHECK_REQUIRED=true
# APP_CHECK_APP_IDS=["your-registered-firebase-web-app-id"]
# ALLOWED_ORIGINS=["https://your-project-id.web.app"]
# STORAGE_BUCKET=your-private-bucket-name
# UPLOAD_RETENTION_NOTICE="A reviewed, accurate retention policy is required before public uploads."
# AI_ENABLED=true
# GEMINI_MODEL=verified-model-id
# GEMINI_LOCATION=verified-model-location
# EXTRACTION_TIMEOUT_SECONDS=90
# MAXIMUM_GENERATIONS_PER_USER_DAY=40
# MAXIMUM_GENERATIONS_GLOBAL_DAY=1000
# MAXIMUM_ACTIVE_EXTRACTIONS_GLOBAL=4
# Keep AI disabled until the project/model/location and service identity are verified.
# Review docs/LIVE_QUOTATION_SETUP.md before preparing a public release.
